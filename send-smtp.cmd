@echo off
chcp 65001 >nul
title Отправка предложений - 6 писем
REM ===================================================================
REM  send-smtp.cmd - ДВОЙНОЙ КЛИК, дальше только два раза ввести.
REM
REM  Почему это работает, а send-smtp.ps1 из моих команд не работал:
REM  там stdin перенаправлен, и Read-Host -AsSecureString ВИСИТ вечно.
REM  Когда ты запускаешь .cmd сам - консоль настоящая, IsInputRedirected=False,
REM  и пароль спрашивается нормально. Пароль уходит в SMTP напрямую и нигде
REM  не сохраняется: ни в .ps1, ни в NOTES.md, ни в sent-log.csv.
REM
REM  Порядок работы:
REM    1. спросит почтовый ящик
REM    2. спросит пароль (для Gmail - код приложения, не сам пароль!)
REM    3. проверит вход на SMTP ДО отправки первого письма
REM    4. отправит 6 писем с паузой 45 секунд между ними
REM    5. запишет отчёт в sent-log.csv
REM ===================================================================

cd /d "%~dp0"

echo.
echo ============================================================
echo   ОТПРАВКА 6 ПИСЕМ
echo ============================================================
echo.
echo   Что уйдёт: 6 писем компаниям без сайта, с 2 вложениями
echo   в каждом (пример сайта и пример админ-панели).
echo.
echo   ВАЖНО про пароль:
echo     Gmail  - нужен КОД ПРИЛОЖЕНИЯ (16 символов), а не пароль.
echo              Настройки аккаунта Google - Безопасность -
echo              Двухэтапная аутентификация - Пароли приложений.
echo     Яндекс - подойдёт обычный пароль, или включи "защиту входа
echo              по приложениям" и возьми там же код.
echo.
echo   Ящик лучше пустой и отдельный, не личный: холодная рассылка
echo   может привести к блокировке, а с личным уйдёт вся почта.
echo.
echo   Esc - отмена в любой момент
echo.

powershell -NoProfile -ExecutionPolicy Bypass -File send-smtp.ps1 -Credential -Limit 0 -DelaySec 45

echo.
echo ============================================================
if errorlevel 2 (
  echo   НЕ ОТПРАВЛЕНО из-за блокеров. Смотри сообщения выше.
) else if errorlevel 3 (
  echo   Отмена или пустой пароль - ничего не отправлено.
) else if errorlevel 4 (
  echo   НЕ ПОДКЛЮЧИЛСЯ к почтовому серверу. Ничего не отправлено.
  echo   Частая причина - пароль вместо кода приложения.
) else if errorlevel 5 (
  echo   Отправлено частично. Подробности в sent-log.csv
) else (
  echo   ВСЕ 6 ПИСЕМ ОТПРАВЛЕНЫ.
  echo.
  echo   Что дальше:
  echo     powershell -ExecutionPolicy Bypass -File pipeline.ps1 stage -Id d001 -To a2
  echo   или просто подожди: run-daily.cmd сам поставит follow-up
  echo   на 4-й, 11-й и 18-й день.
)
echo ============================================================
echo.
pause
