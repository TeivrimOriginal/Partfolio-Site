.git-commit-msg.txt
hh-requirements-latest.json

# HardSearchWork: локальная база с контактами компаний и историей откликов
hardsearchwork.db
hardsearchwork.db-wal
hardsearchwork.db-shm
hsw/hsw.sqlite
hsw/hsw.sqlite-wal
hsw/hsw.sqlite-shm
hsw/test-send.sqlite
# Подготовленные письма: в них адреса компаний и текст откликов. На общий
# доступ это не выкладывается.
hsw/outbox/
hsw/outbox-test/
# Сырой ответ Хабра: артефакт прогона сборщика, 140 КБ и без пользы в репозитории.
hsw/habr-raw.json
# Ящики для рассылки: здесь будут пароли в переменных окружения
mailboxes.csv

# Артефакты запуска окна: лог ошибок и снимки. Лог полезен при разборе сбоя
# на машине пользователя, но в репозитории ему не место.
hsw-error.log
hsw-*.png

# Пробные файлы с префиксом _probe и одноразовые правящие скрипты: появляются
# при разборе сбоя и не должны копиться. Инструменты, которые остаются
# надолго, называются без подчёркивания (test-*, fix-*, check-*).
_probe-*
_*.png
*.bak-*

# Secret-bot: демо-база passkey и файлы страницы — только для проверки,
# в репозиторий не несут ни ключей, ни токенов.
pw-demo.db
pw-demo.db-wal
pw-demo.db-shm
secret-bot/links.db
secret-bot/links.db-wal
secret-bot/links.db-shm
__pycache__/
*.pyc
