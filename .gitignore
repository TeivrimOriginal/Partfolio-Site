.git-commit-msg.txt
hh-requirements-latest.json

# HardSearchWork: локальная база с контактами компаний и историей откликов
hardsearchwork.db
hardsearchwork.db-wal
hardsearchwork.db-shm
# Ящики для рассылки: здесь будут пароли в переменных окружения
mailboxes.csv

# Артефакты запуска окна: лог ошибок и снимки. Лог полезен при разборе сбоя
# на машине пользователя, но в репозитории ему не место.
hsw-error.log
hsw-*.png

# Пробные файлы с префиксом _probe и одноразовые правящие скрипты: появляются
# при разборе сбоя и не должны копиться. Инструменты, которые остаются
# надолго, называются без подчёркивания (test-*, fix-*, check-*).
_probe-*
_*.png
*.bak-*
